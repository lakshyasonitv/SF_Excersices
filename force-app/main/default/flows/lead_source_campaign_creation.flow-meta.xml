            <targetReference>END_ELEMENT_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>no</defaultConnectorLabel>
        <rules>
            <name>campaign</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_campaign.Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>create_campaign_member</targetReference>
            </connector>
