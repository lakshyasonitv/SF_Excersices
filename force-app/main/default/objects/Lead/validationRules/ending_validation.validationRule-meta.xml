<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ending_validation</fullName>
    <active>true</active>
    <description>Should not contain these:
.games
.garden
.glass
.free
.talk</description>
    <errorConditionFormula>REGEX(LOWER(Email), &quot;.*\\.(games|garden|glass|free|talk)&quot;)</errorConditionFormula>
    <errorDisplayField>Email</errorDisplayField>
    <errorMessage>The email can not end with .games
.garden
.glass
.free
.talk</errorMessage>
</ValidationRule>
